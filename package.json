{
  "name": "@rachittshah/tasc",
  "version": "0.1.0",
  "description": "Eval-gated inference policy optimization with deterministic replay and holdout confirmation.",
  "private": true,
  "license": "MIT",
  "keywords": [
    "inference",
    "evaluation",
    "serving",
    "llm",
    "optimization"
  ],
  "type": "module",
  "bin": {
    "tasc": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm test && npm run build && npm pack --dry-run",
    "demo": "tsx scripts/demo.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "tasc": "tsx src/cli.ts"
  },
  "author": {
    "name": "Rachitt Shah",
    "url": "https://github.com/rachittshah"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rachittshah/tasc.git"
  },
  "homepage": "https://github.com/rachittshah/tasc#readme",
  "bugs": {
    "url": "https://github.com/rachittshah/tasc/issues"
  },
  "dependencies": {
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.22.4",
    "typescript": "^5.6.0",
    "vitest": "^4.1.9"
  }
}
